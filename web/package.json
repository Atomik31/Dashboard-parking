{
  "name": "parking-aixpress-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Dashboard des parkings d'Aix-en-Provence (React + Express)",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch --env-file-if-exists=.env server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "firebase": "^13.1.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.14",
    "leaflet": "^1.9.4",
    "leaflet-gesture-handling": "^1.2.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
