# Copie ce fichier en .env (non versionné) et renseigne les valeurs.

# ---------- Serveur ----------
PORT=3000
# Production : NODE_ENV=production (positionné par `npm start` et le Dockerfile)

# Firebase : ID du projet. Sans lui, le serveur refuse tout accès aux routes protégées.
FIREBASE_PROJECT_ID=parking-aixpress
# (optionnel) domaine d'authentification Firebase, pour la CSP (ex. mon-projet.firebaseapp.com)
FIREBASE_AUTH_DOMAIN=parking-aixpress.firebaseapp.com

# Airtable (PAT avec accès en écriture à la base appHnOPUpb7FbokMj). JAMAIS côté client.
AIRTABLE_TOKEN=

# Historique : S3 (utilisateur IAM lecteur) ou, à défaut, dossier local
S3_BUCKET=
AWS_DEFAULT_REGION=eu-west-3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
HISTORY_DIR=../history

# CORS fermé par défaut ; liste d'origines séparées par des virgules si nécessaire
CORS_ORIGINS=
# Nombre de proxys de confiance (1 = Traefik devant le conteneur)
TRUST_PROXY=1

# ---------- DÉVELOPPEMENT UNIQUEMENT ----------
# Désactive la vérification Firebase : le serveur accepte « Authorization: Bearer dev-bypass ».
# Refus de démarrer si NODE_ENV=production. Ne JAMAIS activer sur le VPS.
AUTH_DEV_BYPASS=0

# ---------- Client (Vite, exposées au navigateur : ce ne sont pas des secrets) ----------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=parking-aixpress.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=parking-aixpress
VITE_FIREBASE_APP_ID=1:490680213265:web:757b0ffc9f794934e5f6b0
# DÉVELOPPEMENT UNIQUEMENT : « dev » contourne l'écran de connexion. À mettre dans .env.development (chargé par `npm run dev`
# seulement) ; le build de production refuse cette valeur.
# VITE_AUTH_MODE=dev
